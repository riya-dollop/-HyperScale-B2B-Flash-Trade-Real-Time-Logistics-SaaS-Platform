# -------------------------------------------------------------
# HyperScale B2B Flash-Trade & Real-Time Logistics SaaS
# Production-grade Environment Configuration
# -------------------------------------------------------------

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB)
MONGO_URI=mongodb://localhost:27017/hyperscale_saas

# Redis (Caching, Rate Limiting & Token Blacklist)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ (Reliable Inter-Service Message Broker)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Apache Kafka (High-Throughput Activity Logs & Event Streaming)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=hyperscale-saas-core
KAFKA_GROUP_ID=hyperscale-analytics-group

# Authentication (JWT Access & Refresh Rotation)
JWT_ACCESS_SECRET=hyperscale_super_secure_jwt_access_secret_key_2026_xyz
JWT_REFRESH_SECRET=hyperscale_super_secure_jwt_refresh_secret_key_2026_abc
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# AWS S3 Cloud Storage
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=mock_aws_access_key
AWS_SECRET_ACCESS_KEY=mock_aws_secret_key
AWS_S3_BUCKET_NAME=hyperscale-saas-media

# Payment Gateways (Stripe & Razorpay)
STRIPE_SECRET_KEY=sk_test_mock_stripe_key_hyperscale
STRIPE_WEBHOOK_SECRET=whsec_mock_stripe_webhook_secret
RAZORPAY_KEY_ID=rzp_test_mock_key
RAZORPAY_KEY_SECRET=rzp_mock_secret_key

# Firebase Cloud Messaging (FCM) Placeholder
FCM_SERVER_KEY=mock_firebase_cloud_messaging_server_key

